# Watermelon Planta — ignorar archivos sensibles / locales

# TDMS capturados localmente
data/captures/*.tdms
data/captures/.*

# Token JWT de auth (NO COMMITEAR — JWT del user logueado)
data/.auth.json

# SQLite de tracking de uploads (estado local)
data/sync_state.db
data/sync_state.db-journal
data/sync_state.db-shm
data/sync_state.db-wal

# Flag de onboarding (estado local, por usuario)
data/.onboarded.flag

# Streamlit secrets reales (mantener solo el .example)
.streamlit/secrets.toml

# Python cache
__pycache__/
*.pyc

# PyInstaller build artifacts (FASE C v3.31.213+)
installer/build/
installer/dist/
installer/__pycache__/

# Inno Setup compiled installer
installer/Output/
