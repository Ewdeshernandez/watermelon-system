# =========================================================
# Watermelon Planta · Credenciales del proyecto Supabase
# =========================================================
# Este archivo es un TEMPLATE. Para activar el sync con el Cloud:
#
# 1. Copia este archivo como  secrets.toml  (sin el .example)
# 2. Llena las claves con las del proyecto Watermelon Cloud
# 3. NO commitees secrets.toml — ya está en .gitignore
#
# Las claves son las del proyecto Supabase del Watermelon Cloud.
# Las puedes encontrar en:
#   Supabase Dashboard → Settings → API
#   URL: el "Project URL"
#   anon_key: el "anon public" key (NO el "service_role" key)
#
# El anon_key es PÚBLICO por diseño — está pensado para frontend.
# Lo que protege los datos es RLS (Row Level Security) sobre el bucket
# modal-captures.
# =========================================================

[supabase]
url = "https://xxxxxxxxxxxxxxxx.supabase.co"
anon_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
