# =============================================================
# Watermelon System — .gitignore
# =============================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Entornos virtuales ---
.venv/
venv/
env/
.env
.envrc

# --- Editores / SO ---
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# --- Logs y temporales ---
*.log
*.bak
*.save
*.tmp
*.cache

# --- Streamlit secrets (NUNCA commitear) ---
.streamlit/secrets.toml

# --- Estado de runtime de la app (no es código) ---
data/report_state.json
data/report_drafts/

# --- Document Vault (datos del usuario, NO commitear) ---
data/asset_documents/
data/asset_metadata/

# --- Asset Instances (Ciclo 8: datos por máquina física, NO commitear) ---
data/instances/

# --- Usuarios fallback locales (NO commitear, contienen hashes) ---
data/users/

# --- Caches y estados runtime de IA / briefings ---
data/cache/
data/briefings/
data/password_reset_tokens/
data/ai_diagnostic_stats.json

# --- Worktrees / agentes locales ---
.claude/

# --- Document Vault SEEDS (manuales de fábrica, SÍ commitear) ---
# Esta carpeta contiene PDFs de referencia (manuales OEM, reportes
# históricos del cliente) que viven en el repo y sobreviven cualquier
# redeploy de Streamlit Cloud. Se sobrescribe la regla global *.pdf
# de más abajo para esta carpeta específica.
!data/asset_documents_seed/
!data/asset_documents_seed/**

# --- Backups manuales ---
backup_*/
backup_phase*/
*_backup_*/

# --- Outputs locales no versionables ---
exports/
*.pdf
!docs/*.pdf
!data/asset_documents_seed/**/*.pdf

# --- Sistema de licencias RSA (FASE D) ---
# CRÍTICO: la private_key.pem NUNCA debe llegar al repo.
# Si se filtra, hay que regenerar TODAS las licencias emitidas y
# hacer rebuild de Watermelon Planta con nueva public key.
tools/.keys/
tools/.keys/**
tools/licenses_issued/
tools/licenses_issued/**

# --- Licencia activa del cliente (en Planta Edition) ---
# El token va en planta/data/ del cliente final, NO del dev.
planta/data/license.token
planta/data/.license_cache.json

# --- Cache del auto-updater (FASE F) ---
# Local del cliente, no commitear.
planta/data/.update_check_cache.json
planta/data/.no_updates.flag

# --- Cache de verificación de revocación (FASE J) ---
planta/data/.revocation_cache.json

# Watermelon Planta — driver runtime del fabricante (binario grande, no va al repo)
planta/installer/dependencies/driver-extracted/
planta/installer/dist/
planta/installer/build/
