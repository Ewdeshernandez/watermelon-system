  "instance_id": "turbina_sgt300_b",
  "description": "Parex · Turbogenerador SGT300 B (Siemens SGT-300 + gearbox + Generador Hyundai Ideal). Bently 3500 Modbus Gateway 192.168.1.228. Servidor de sitio alcanza el gateway (src 192.168.1.102).",
  "modbus": {
    "server_ip": "192.168.1.228",
    "port": 502,
    "unit_id": 1,
    "registers_per_value": 2,
    "byte_order": "ABCD",
    "_byte_order_options": [
      "ABCD = big-endian (default Bently)",
      "CDAB = word-swapped",
      "BADC = byte-swapped",
      "DCBA = little-endian full"
    ]
  },
  "poll_interval_seconds": 10,
  "_units_note": "Parex SGT300: proximidad µm pp, velocidad mm/s rms, aceleración g rms (confirmado por el cliente). Si el dry-run da números absurdos, probar byte_order CDAB.",
