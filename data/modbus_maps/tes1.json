      "kind": "sensor",
      "sensor_label": "1Y_V",
      "plane": 1,
      "direction": "Y",
      "sensor_type": "velocity",
      "location": "CRF",
      "variable": "1YV VEL CRF",
      "metric": "Direct",
      "unit": "in/s pk",
      "encoding": "float32",
      "csv_match_pattern": "*1YV*VEL*CRF*, *CRF*VEL*"
    },
    "6025": {
      "kind": "sensor",
