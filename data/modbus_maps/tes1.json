{
  "instance_id": "tes1",
  "description": "Turbogenerador TES #1 — LM6000 + Brush. Bently Nevada 3500/92 Modbus Gateway en planta Magnex (Ecopetrol).",
  "modbus": {
    "server_ip": "192.168.1.77",
    "port": 502,
    "unit_id": 1,
    "registers_per_value": 2,
    "byte_order": "ABCD",
    "_byte_order_options": [
      "ABCD = big-endian (default Bently)",
      "CDAB = word-swapped",
      "BADC = byte-swapped",
      "DCBA = little-endian full"
    ]
  },
  "poll_interval_seconds": 10,
  "registers": {
    "6041": {
      "kind": "speed",
      "variable": "Velocidad Generador",
      "metric": "Direct",
      "unit": "rpm",
      "encoding": "float32"
    },
