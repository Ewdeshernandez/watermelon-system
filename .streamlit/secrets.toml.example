# =============================================================
# SUPABASE — Ciclo 9 (persistencia real del Vault)
# =============================================================
# Si esta sección está completa con url + service_key válidos, la app
# guarda Asset Instances + parámetros + documentos en Supabase Postgres
# + Storage. Si NO está, cae a filesystem local (efímero en Streamlit
# Cloud — se pierde en cada redeploy).
#
# Setup paso a paso (5–10 minutos):
#   1. Andá a https://supabase.com → "Start your project" → cuenta gratis
#   2. Create a new project → región más cercana + contraseña fuerte de DB
#   3. Esperá ~1 minuto que se aprovisione
#   4. Project Settings → API: copiá Project URL y service_role key
#      (¡el service_role, NO el anon key — necesitamos full read/write!)
#   5. SQL Editor → New query → pegá data/supabase_schema.sql → Run
#      → crea la tabla 'instances'
#   6. Storage → Create new bucket: nombre 'instance-documents',
#      Public bucket → DESACTIVADO
#   7. Pegá los valores acá:
#
# [supabase]
# url         = "https://xxxxxxxxxxxxxx.supabase.co"
# service_key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# bucket      = "instance-documents"
#
# En Streamlit Cloud: estos valores van en Settings → Secrets de cada
# app, NO en este archivo (que solo sirve para desarrollo local).


# =============================================================
# WHATSAPP — Ciclo 23.150 (envío del reporte al cliente)
# =============================================================
# Envío del reporte ejecutivo PDF por WhatsApp usando la Meta WhatsApp
# Cloud API (la misma cuenta del watermelon-bot).
#
# Cómo obtener los valores (Meta for Developers → tu App → WhatsApp → API Setup):
#   - phone_number_id: el "Phone number ID" del número del WABA.
#   - access_token:    token del System User (permanente, scope whatsapp_business_messaging).
#
# template_name / template_lang (PRODUCCIÓN):
#   Los envíos PROGRAMADOS son "iniciados por el negocio" (fuera de la
#   ventana de 24 h), así que Meta EXIGE una PLANTILLA pre-aprobada.
#   Creá en Meta una plantilla (categoría UTILITY) con:
#     - Header: tipo DOCUMENTO
#     - Body con 3 variables: "{{1}} — Estado: {{2}}. Reporte de condición del {{3}}.
#       Adjuntamos el PDF ejecutivo. — SIGA / Watermelon System."
#   Una vez aprobada, poné su nombre en template_name.
#   Si dejás template_name vacío, se envía como DOCUMENTO directo, que SOLO
#   funciona dentro de la ventana de 24 h (sirve para testing: escribile
#   primero al número desde el WhatsApp del cliente).
#
# [whatsapp]
# phone_number_id = "1234567890"
# access_token    = "EAAG..."
# api_version     = "v21.0"
# template_name   = "reporte_condicion"
# template_lang   = "es"


# =============================================================
# EMAIL — envío del reporte por correo
# =============================================================
# Ya documentado en core/email_sender.py. Usar [email.graph] (Microsoft
# Graph) o [email.smtp]. El reporte se adjunta como PDF.
#
# [email.graph]
# tenant_id     = "..."
# client_id     = "..."
# client_secret = "..."
# from_email    = "monitoreo@sigasas.com"


